# WSLg 走 XWayland, 启动需要 --disable=wayland
# 常用命令:
#   配置GUI:  fcitx5-configtool
#   重载配置: fcitx5-remote -r
#   关闭:     systemctl --user stop fcitx5.service || pkill fcitx5
#   诊断:     fcitx5-diagnose

[Unit]
Description=Fcitx 5 Input Method
After=graphical-session.target
Wants=graphical-session.target

[Service]
Environment=DISPLAY=:0
ExecStart=/usr/bin/fcitx5 --disable=wayland
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
