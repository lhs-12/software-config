#!/bin/bash

# ===============================================================
# Arch Linux 系统清理助手
# ===============================================================
# 【功能说明】
# - 删除孤儿包与无主 debug 符号包
# - 清空全部 pacman 包缓存 (下次操作前需 pacman -Sy)
# - 清空全部 AUR 缓存 (克隆目录与助手缓存)
# - 清理包缓存残留 (download-*, *.part)
# - systemd journal 轮转并收缩 (保留 2 周, 上限 300M)
# - 清理崩溃转储 (coredump)
# - 清空回收站 (含外置磁盘) 与全部缩略图
# - 移除未使用 Flatpak runtime 及已卸载应用残留
# - 开发工具缓存清理 (mise, uv, ...)
# - snapper 快照按 number 策略清理 (仅 btrfs + snapper 环境)
#
# 【手动清理命令(需要时手动执行)】
# - KDE baloo 文件索引: balooctl6 purge
# ===============================================================

set -Eeuo pipefail
trap 'echo "ERROR at line $LINENO: $BASH_COMMAND" >&2' ERR

# ------------------------------
# 1. Default parameters
# ------------------------------
UI_LANG=$([[ ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} == zh* ]] && echo zh || echo en)

XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# ------------------------------
# 2. Usage / Argument parsing
# ------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --ui-lang zh|en    Force UI language (default: auto)
  --help, -h         Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ui-lang) [[ "${2:-}" =~ ^(zh|en)$ ]] && UI_LANG="$2" && shift 2 || { echo "Error: --ui-lang requires zh or en."; exit 1; } ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
done

# ------------------------------
# 3. Localization Logic
# ------------------------------
LANG_TABLE='
TAG_INFO    | [INFO]  | [消息]
TAG_SUCCESS | [OK]    | [成功]
TAG_WARN    | [WARN]  | [注意]
TAG_ERROR   | [ERROR] | [错误]

MSG_DESC_TITLE    | The script will perform the following cleanup tasks:                | 本脚本将执行以下清理操作：
MSG_DESC_1        | - Remove orphaned packages & orphaned debug packages                | - 删除孤儿包与无主 debug 符号包
MSG_DESC_2        | - Clear ALL pacman package cache (run pacman -Sy before next op)    | - 清空全部 pacman 包缓存 (下次操作前需 pacman -Sy)
MSG_DESC_3        | - Clear ALL AUR caches (clone dirs & helper cache)                  | - 清空全部 AUR 缓存 (克隆目录与助手缓存)
MSG_DESC_4        | - Remove residual download-* dirs and *.part files                  | - 清理包缓存残留 (download-*, *.part)
MSG_DESC_5        | - Rotate & vacuum systemd journal (keep 2 weeks, max 300M)          | - systemd journal 轮转并收缩 (保留 2 周, 上限 300M)
MSG_DESC_6        | - Remove crash dumps (coredump)                                     | - 清理崩溃转储 (coredump)
MSG_DESC_7        | - Empty Trash (incl. external drives) and all thumbnails            | - 清空回收站 (含外置磁盘) 与全部缩略图
MSG_DESC_8        | - Remove unused Flatpak runtimes & uninstalled app leftovers        | - 移除未使用 Flatpak runtime 及已卸载应用残留
MSG_DESC_9        | - Prune dev cache                                                   | - 清理开发工具缓存
MSG_DESC_10       | - Snapper snapshot cleanup (number policy only)                     | - snapper 快照清理 (仅 number 策略)
MSG_ASK_CONFIRM   | Continue with cleanup? [y/N]                                        | 是否继续执行清理？[y/N]
MSG_ABORT         | Cleanup cancelled by user.                                          | 用户已取消清理。
MSG_DONE          | System cleanup completed!                                           | 系统清理完成！

MSG_NO_PM         | No supported package manager (paru/yay/pacman).                     | 未找到受支持的包管理器 (paru/yay/pacman)
MSG_HELPER_USE    | Using package manager: %s                                           | 使用包管理器：%s

MSG_STEP_ORPHAN        | Checking for orphaned packages...                    | 正在检查孤儿软件包...
MSG_ORPHAN_FOUND       | Orphaned packages detected:                          | 发现孤儿软件包：
MSG_ORPHAN_DEBUG_FOUND | Orphaned debug packages detected:                    | 发现无主 debug 符号包：
MSG_ORPHAN_CLEAN       | Orphaned packages removed.                           | 已删除孤儿软件包。
MSG_ORPHAN_NONE        | No orphaned packages found.                          | 未发现孤儿软件包。

MSG_STEP_CACHE    | Clearing ALL pacman package cache...                 | 正在清空全部 pacman 包缓存...
MSG_CACHE_DONE    | Pacman package cache cleared.                        | pacman 包缓存已清空。

MSG_STEP_AUR      | Clearing ALL AUR caches...                           | 正在清空全部 AUR 缓存...
MSG_AUR_DONE      | AUR caches cleared.                                  | AUR 缓存已清空。

MSG_STEP_BROKEN   | Cleaning residual download directories...            | 正在清理残留下载目录...
MSG_BROKEN_DONE   | Residual directories removed.                        | 残留目录已清理。

MSG_STEP_LOG      | Vacuuming systemd journal logs...                    | 正在清理 systemd 日志...
MSG_LOG_DONE      | Systemd journal logs cleaned.                        | 系统日志已清理。

MSG_STEP_CORE     | Removing crash dumps...                              | 正在清理崩溃转储...
MSG_CORE_DONE     | Crash dumps removed.                                 | 崩溃转储已清理。

MSG_STEP_TRASH    | Emptying Trash (incl. external drives)...            | 正在清空回收站 (含外置磁盘)...
MSG_TRASH_DONE    | Trash emptied.                                       | 回收站已清空。
MSG_STEP_THUMB    | Clearing all thumbnails...                           | 正在清空全部缩略图...
MSG_THUMB_DONE    | Thumbnails cleared.                                  | 缩略图已清空。

MSG_STEP_FLATPAK      | Removing unused Flatpak runtimes...              | 正在移除未使用的 Flatpak runtime...
MSG_FLATPAK_DONE      | Unused Flatpak runtimes removed.                 | 未使用的 Flatpak runtime 已删除。
MSG_STEP_FLATPAK_LEFT | Cleaning Flatpak app leftovers...                | 正在清理 Flatpak 应用残留...
MSG_FLATPAK_LEFT_DONE | Flatpak app leftovers cleaned.                   | Flatpak 应用残留已清理。

MSG_STEP_DEV      | Cleaning developer tool caches...                    | 正在清理开发工具缓存...
MSG_DEV_DONE      | Developer tool caches cleaned.                       | 开发工具缓存已清理。

MSG_STEP_SNAP     | Cleaning snapper snapshots (number policy)...        | 正在清理 snapper 快照 (number 策略)...
MSG_SNAP_DONE     | Snapper snapshots cleaned.                           | snapper 快照已清理。
'
while IFS='|' read -r v e c; do
  v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
  e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"
  [[ -z "$v" || "$v" == \#* ]] && continue
  val=$e; [[ $UI_LANG == zh ]] && val=$c; printf -v "$v" '%s' "$val"
done <<<"$LANG_TABLE"

# ------------------------------
# 4. Define Logging Functions
# ------------------------------
NC=$'\033[0m'
BLUE=$'\033[1;34m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[1;31m'
DIM=$'\033[2m'
_info()    { printf "%s%-12s%s %s\n" "${BLUE}"   "${TAG_INFO}"    "${NC}" "$1"; }
_success() { printf "%s%-12s%s %s\n" "${GREEN}"  "${TAG_SUCCESS}" "${NC}" "$1"; }
_warn()    { printf "%s%-12s%s %s\n" "${YELLOW}" "${TAG_WARN}"    "${NC}" "$1"; }
_error()   { printf "%s%-12s%s %s\n" "${RED}"    "${TAG_ERROR}"   "${NC}" "$1"; exit 1; }

# 打印并执行命令 (命令不存在则跳过; 失败只输出 stderr, 不中断脚本)
print_and_execute() {
    command -v "$1" >/dev/null 2>&1 || return 0
    printf "%s  $ %s%s\n" "$DIM" "$*" "$NC"
    "$@" >/dev/null || true
}

# ------------------------------
# 5. Confirmation Prompt
# ------------------------------
printf "\n%s=======================================================%s" "$BLUE" "$NC"
printf "\n%s" "$MSG_DESC_TITLE"
printf "\n%s" "$MSG_DESC_1"
printf "\n%s" "$MSG_DESC_2"
printf "\n%s" "$MSG_DESC_3"
printf "\n%s" "$MSG_DESC_4"
printf "\n%s" "$MSG_DESC_5"
printf "\n%s" "$MSG_DESC_6"
printf "\n%s" "$MSG_DESC_7"
printf "\n%s" "$MSG_DESC_8"
printf "\n%s" "$MSG_DESC_9"
printf "\n%s" "$MSG_DESC_10"
printf "\n%s=======================================================%s" "$BLUE" "$NC"
printf "\n%s%s %s" "$YELLOW" "$MSG_ASK_CONFIRM" "$NC"
read -r confirm || true
case "$confirm" in
    [yY]) ;;
    *) printf "%s\n" "$MSG_ABORT"; exit 0 ;;
esac

# Sudo
sudo -v

# ------------------------------
# 6. Package Manager
# ------------------------------
{ command -v paru   &>/dev/null && AUR_HELPER=paru;   } ||
{ command -v yay    &>/dev/null && AUR_HELPER=yay;    } ||
{ command -v pacman &>/dev/null && AUR_HELPER=pacman; } ||
_error "$MSG_NO_PM"

_info "$(printf "$MSG_HELPER_USE" "$AUR_HELPER")"

# pacman 缓存目录 (可配置多个)
mapfile -t PAC_CACHE_DIRS < <(pacman-conf CacheDir 2>/dev/null | sed 's:/*$::' | grep . || true)
if [ "${#PAC_CACHE_DIRS[@]}" -eq 0 ]; then
    PAC_CACHE_DIRS=(/var/cache/pacman/pkg)
fi

# paru 克隆目录: 读 paru.conf 的 CloneDir
paru_clone_dir() {
    local f v
    for f in "$XDG_CONFIG_HOME/paru/paru.conf" /etc/paru.conf; do
        [ -f "$f" ] || continue
        v=$(grep -E '^\s*CloneDir\s*=' "$f" 2>/dev/null | tail -1 | cut -d= -f2- | xargs || true)
        [ -n "$v" ] && { echo "${v/#\~/$HOME}"; return; }
    done
    echo "$XDG_CACHE_HOME/paru/clone"
}

# yay 构建目录: 读 yay -Pg 的 buildDir
yay_build_dir() {
    local v
    v=$(yay -Pg 2>/dev/null | grep -oP '"buildDir":\s*"\K[^"]+' || true)
    echo "${v:-$XDG_CACHE_HOME/yay}"
}

# ------------------------------
# 7. Cleanup Function
# ------------------------------

# [Step 1] Orphans
_info "$MSG_STEP_ORPHAN"

# 传统孤儿包 (作为依赖安装但不再被任何包硬依赖)
ORPHANS=$(pacman -Qtdq 2>/dev/null || true)
# 无主包的 -debug 符号包 (主包已卸载, debug 包残留)
ORPHAN_DEBUGS=$(
    while IFS= read -r pkg; do
        base="${pkg%-debug}"
        [ -n "$base" ] || continue
        pacman -Qi "$base" >/dev/null 2>&1 || echo "$pkg"
    done < <(pacman -Qq 2>/dev/null | grep -- '-debug$' || true)
)

if [ -n "$ORPHANS" ]; then
    printf "%s%s%s\n" "$YELLOW" "$MSG_ORPHAN_FOUND" "$NC"
    printf "%s\n" "$ORPHANS"
fi
if [ -n "$ORPHAN_DEBUGS" ]; then
    printf "%s%s%s\n" "$YELLOW" "$MSG_ORPHAN_DEBUG_FOUND" "$NC"
    printf "%s\n" "$ORPHAN_DEBUGS"
fi

# 合并去重后一次性删除
mapfile -t ORPHAN_ARR < <(printf '%s\n' "$ORPHANS" "$ORPHAN_DEBUGS" | sed '/^$/d' | sort -u)
if [ "${#ORPHAN_ARR[@]}" -gt 0 ]; then
    sudo pacman -Rns --noconfirm "${ORPHAN_ARR[@]}" >/dev/null
    _success "$MSG_ORPHAN_CLEAN"
else
    _success "$MSG_ORPHAN_NONE"
fi

# [Step 2] Pacman Cache
_info "$MSG_STEP_CACHE"
yes | sudo pacman -Scc >/dev/null 2>&1 || true
_success "$MSG_CACHE_DONE"

# [Step 3] AUR Cache
_info "$MSG_STEP_AUR"

AUR_CLONE_DIRS=()
if command -v paru >/dev/null 2>&1; then AUR_CLONE_DIRS+=("$(paru_clone_dir)"); fi
if command -v yay  >/dev/null 2>&1; then AUR_CLONE_DIRS+=("$(yay_build_dir)"); fi
for d in "${AUR_CLONE_DIRS[@]}"; do
    if [ -d "$d" ]; then
        find "$d" -mindepth 1 -xdev -delete 2>/dev/null || true
    fi
done
command -v paru >/dev/null 2>&1 && yes | paru -Scc --aur >/dev/null 2>&1 || true
command -v yay  >/dev/null 2>&1 && yes | yay  -Scc --aur >/dev/null 2>&1 || true
_success "$MSG_AUR_DONE"

# [Step 4] Broken Downloads
_info "$MSG_STEP_BROKEN"
for d in "${PAC_CACHE_DIRS[@]}"; do
    if [ -d "$d" ]; then
        sudo find "$d" -maxdepth 1 \( -type d -name "download-*" -o -type f -name "*.part" \) -exec rm -rf {} + 2>/dev/null || true
    fi
done
_success "$MSG_BROKEN_DONE"

# [Step 5] Journal
_info "$MSG_STEP_LOG"
sudo journalctl --rotate >/dev/null 2>&1 || true
sudo journalctl --vacuum-time=2weeks --vacuum-size=300M >/dev/null 2>&1 || true
_success "$MSG_LOG_DONE"

# [Step 6] Coredump
if [ -d /var/lib/systemd/coredump ]; then
    _info "$MSG_STEP_CORE"
    sudo find /var/lib/systemd/coredump -maxdepth 1 -type f -name 'core.*' -delete 2>/dev/null || true
    _success "$MSG_CORE_DONE"
fi

# [Step 7] Trash & Thumbnails
_info "$MSG_STEP_TRASH"
TRASH_DIRS=("$XDG_DATA_HOME/Trash")
while IFS= read -r mount; do
    case "$mount" in
        /run/media/*|/media/*|/mnt/*) ;;
        *) continue ;;
    esac
    if [ -d "$mount/.Trash-$UID" ]; then
        TRASH_DIRS+=("$mount/.Trash-$UID")
    fi
done < <(findmnt -rn -o TARGET 2>/dev/null || true)
for t in "${TRASH_DIRS[@]}"; do
    if [ -d "$t" ]; then
        find "$t" -mindepth 1 -xdev -delete 2>/dev/null || true
    fi
done
_success "$MSG_TRASH_DONE"

_info "$MSG_STEP_THUMB"
if [ -d "$XDG_CACHE_HOME/thumbnails" ]; then
    find "$XDG_CACHE_HOME/thumbnails" -mindepth 1 -xdev -delete 2>/dev/null || true
fi
_success "$MSG_THUMB_DONE"

# [Step 8] Flatpak: 未使用 runtime + 已卸载应用残留
if command -v flatpak >/dev/null 2>&1; then
    _info "$MSG_STEP_FLATPAK"
    flatpak uninstall --unused -y >/dev/null 2>&1 || true
    _success "$MSG_FLATPAK_DONE"

    # 已卸载应用: 删除 ~/.var/app 数据目录; 已安装应用: 只清 cache
    if [ -d "$HOME/.var/app" ]; then
        if INSTALLED_APPS=$(flatpak list --app --columns=application 2>/dev/null); then
            _info "$MSG_STEP_FLATPAK_LEFT"
            for d in "$HOME/.var/app"/*/; do
                [ -d "$d" ] || continue
                app_id=$(basename "$d")
                if grep -qxF "$app_id" <<<"$INSTALLED_APPS"; then
                    if [ -d "$d/cache" ]; then
                        find "$d/cache" -mindepth 1 -xdev -delete 2>/dev/null || true
                    fi
                else
                    rm -rf -- "${d%/}"
                fi
            done
            _success "$MSG_FLATPAK_LEFT_DONE"
        fi
    fi
fi

# [Step 9] Dev Cache
_info "$MSG_STEP_DEV"
print_and_execute mise prune
print_and_execute mise cache clear
print_and_execute aube store prune
print_and_execute aube cache prune
print_and_execute npm cache clean --force
print_and_execute uv cache prune
_success "$MSG_DEV_DONE"

# [Step 10] Snapper: number 清理策略
if command -v btrfs >/dev/null 2>&1 \
    && command -v snapper >/dev/null 2>&1 \
    && findmnt -f -n -o FSTYPE / 2>/dev/null | grep -q btrfs; then
    _info "$MSG_STEP_SNAP"
    while IFS= read -r conf; do
        [ -z "$conf" ] && continue
        sudo snapper -c "$conf" cleanup number >/dev/null 2>&1 || true
    done < <(sudo LC_ALL=C snapper list-configs 2>/dev/null | awk -F'|' 'NR>2 {print $1}' | tr -d ' ' || true)
    _success "$MSG_SNAP_DONE"
fi

printf "\n"
_success "$MSG_DONE"
