#!/bin/bash

# ===============================================================
# Arch Linux 系统更新助手
# ===============================================================
# 【功能说明】
# 01. 支持从 Arch Linux 官方/中文社区获取最新新闻资讯
# 02. 智能解析新闻并高亮显示需要"手动干预"的警告信息
# 03. 等待用户确认后执行系统更新
# 04. 更新前自动创建快照, 出问题可回滚
# 05. 官方仓库与 AUR 分开升级, AUR 助手 (paru/yay) 可选
# 06. 智能更新 GPG 密钥环 (keyring)
# 07. 自动更新 Flatpak 应用
# 08. 更新后自动执行 GRUB 配置更新
# 09. 自动请求并后台保持 sudo 权限
# 10. 自动检测系统语言实现多语言支持 (中/英)
# ===============================================================
# 【命令行参数】
# --ui-lang      zh|en        指定脚本交互语言(中/英)
# --news-source  official|cn  指定新闻源(官方/中文社区)
# --count N                   限制最多显示的新闻条数
# --help, -h                  显示帮助信息
# ===============================================================

set -Eeuo pipefail
trap 'echo "ERROR at line $LINENO: $BASH_COMMAND" >&2' ERR
# ------------------------------
# 1. Default parameters
# ------------------------------
# Default news count limit
COUNT_LIMIT=15
# Default news source
NEWS_SOURCE="official"
# Default UI language
UI_LANG=$([[ ${LC_ALL:-${LC_MESSAGES:-${LANG}}} == zh* ]] && echo zh || echo en)

# ------------------------------
# 2. Argument parsing (GNU-style)
# ------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --ui-lang zh|en            UI language (default: auto)
  --news-source official|cn  News source (default: official)
  --count N                  Max number of news items (default: 15)
  --help, -h                 Show this help and exit
EOF
}
die_usage() {
    printf "Error: %s\n\n" "$1" >&2
    usage >&2
    exit 1
}
while [[ $# -gt 0 ]]; do
    case "$1" in
        --ui-lang)     [[ ${2:-} =~ ^(zh|en)$ ]]       && UI_LANG="$2"     && shift 2 || die_usage "--ui-lang requires zh or en" ;;
        --news-source) [[ ${2:-} =~ ^(official|cn)$ ]] && NEWS_SOURCE="$2" && shift 2 || die_usage "--news-source requires official or cn" ;;
        --count)       [[ ${2:-} =~ ^[1-9][0-9]*$ ]]   && COUNT_LIMIT="$2" && shift 2 || die_usage "--count requires a positive integer" ;;
        --help | -h) usage; exit 0 ;;
        *) die_usage "Unknown option: $1" ;;
    esac
done

# ------------------------------
# 3. Localization Logic
# ------------------------------
LANG_TABLE='
TAG_INFO         | [INFO]                                   | [消息]
TAG_SUCCESS      | [OK]                                     | [成功]
TAG_WARN         | [WARN]                                   | [注意]
TAG_ERROR        | [ERROR]                                  | [错误]

MSG_REQ_SUDO     | Requesting sudo...                       | 正在请求管理员权限以更新系统...
MSG_SUDO_FAIL    | Sudo privileges required. Exiting...     | 需要管理员权限才能更新系统。已退出。
MSG_PREPARING    | Preparing update (%s)...                 | 准备更新系统 (%s)...
MSG_FETCHING     | Fetching news...                         | 正在获取 Arch Linux 新闻...
MSG_NEWS_HEADER  | Recent {0} Arch Linux news items:        | 最近 {0} 条 Arch Linux 新闻：
MSG_CONFIRM      | Proceed with the update?                 | 确认开始更新吗？
MSG_CANCEL       | Update cancelled.                        | 更新已取消。
MSG_ERR_FETCH    | Failed to fetch news                     | 获取新闻失败（网络或源错误）
MSG_FORCE_ASK    | Force update anyway?                     | 是否忽略新闻强制更新？
MSG_FORCING      | Forcing update...                        | 正在强制更新...
MSG_EXIT         | Safe exit.                               | 安全退出。
MSG_DONE         | System update finished.                  | 系统更新完成。

MSG_STEP_1       | [1/7] Creating snapshot...               | [1/7] 正在创建快照...
MSG_NO_SNAPPER   | No snapper, skip                         | 未找到 snapper, 跳过快照
MSG_NO_SNAPCFG   | No snapper configs, skip                 | 未找到 snapper 配置, 跳过快照
MSG_SNAP_CREATED | pre-archupdate-%s created                | pre-archupdate-%s 已创建
MSG_STEP_2       | [2/7] Sync DB & keyrings...              | [2/7] 同步数据库并更新密钥环...
MSG_KEYRING_OK   | DB & keyrings synced.                    | 数据库与密钥环已同步。
MSG_KEYRING_WARN | Keyring issues detected, continue...     | 密钥环更新遇到问题, 继续尝试系统更新...
MSG_STEP_3       | [3/7] Upgrading official repos...        | [3/7] 正在升级官方仓库软件包...
MSG_REPO_OK      | Repo packages upgraded.                  | 官方仓库软件包已升级。
MSG_STEP_4       | [4/7] Upgrading AUR...                   | [4/7] 正在升级 AUR 软件包...
MSG_AUR_NONE     | No AUR helper (paru/yay), skip           | 未找到 AUR 助手 (paru/yay), 跳过
MSG_AUR_OK       | AUR packages upgraded.                   | AUR 软件包已升级。
MSG_AUR_FAIL     | AUR upgrade failed. System still intact. | AUR 升级失败。官方仓库已升级, 系统仍完整。
MSG_AUR_RETRY    | Retry later with: %s                     | 可稍后单独重试：%s
MSG_STEP_5       | [5/7] Checking Flatpak updates...        | [5/7] 检查 Flatpak 更新...
MSG_FLATPAK_NONE | No Flatpak, skip                         | 未安装 Flatpak, 跳过
MSG_FLATPAK_FAIL | Flatpak update failed, continue.         | Flatpak 更新失败, 继续后续步骤。
MSG_STEP_6       | [6/7] Updating GRUB...                   | [6/7] 更新 GRUB 配置...
MSG_GRUB_OK      | GRUB updated.                            | GRUB 更新成功。
MSG_GRUB_FAIL    | GRUB update failed.                      | GRUB 更新失败。
MSG_GRUB_MISSING | Skip GRUB update (grub-mkconfig missing) | 跳过 GRUB 更新(grub-mkconfig 缺失)
MSG_STEP_7       | [7/7] Updating Mise...                   | [7/7] 更新 Mise...
MSG_MISE_NONE    | No Mise, skip                            | 未找到 Mise, 跳过
MSG_WARN_PARTIAL | Update failed. Retry before installing any packages. | 更新失败. 请重试, 成功前勿装新包!
'
while IFS='|' read -r v e c; do
  v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
  e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"
  [[ -z "$v" || "$v" == \#* ]] && continue
  val=$e; [[ $UI_LANG == zh ]] && val=$c; printf -v "$v" '%s' "$val"
done <<<"$LANG_TABLE"

# ------------------------------
# 4. Define Logging Functions
# ------------------------------
NC=$'\033[0m'
H_BLUE=$'\033[1;34m'
H_GREEN=$'\033[1;32m'
H_YELLOW=$'\033[1;33m'
H_RED=$'\033[1;31m'
_info()    { printf "%s%-12s%s %s\n" "${H_BLUE}"   "${TAG_INFO}"    "${NC}" "$1"; }
_success() { printf "%s%-12s%s %s\n" "${H_GREEN}"  "${TAG_SUCCESS}" "${NC}" "$1"; }
_warn()    { printf "%s%-12s%s %s\n" "${H_YELLOW}" "${TAG_WARN}"    "${NC}" "$1"; }
_error()   { printf "%s%-12s%s %s\n" "${H_RED}"    "${TAG_ERROR}"   "${NC}" "$1"; exit 1; }

# ask <Y|N> <message>: return 0 for "yes"; a failed read (EOF/non-tty) counts as "no"
ask() {
    local default=$1 msg=$2 hint answer
    [[ $default == Y ]] && hint="[Y/n]" || hint="[y/N]"
    printf "%s %s " "$msg" "$hint"
    if ! read -r answer; then printf "\n"; return 1; fi
    [[ ${answer:-$default} =~ ^[Yy] ]]
}

# ------------------------------
# 5. Request Privileges
# ------------------------------
_info "$MSG_REQ_SUDO"
if ! sudo -v; then
    _error "$MSG_SUDO_FAIL"
fi
# Keep sudo alive in background
( while true; do sudo -n true 2>/dev/null || exit; sleep 60 || exit; done ) &
SUDO_PID=$!
trap 'kill "$SUDO_PID" 2>/dev/null || true' EXIT INT TERM

# ------------------------------
# 6. Detect AUR Helper (optional)
# ------------------------------
AUR_HELPER=""
AUR_OPTS=()
if command -v paru &>/dev/null; then
    AUR_HELPER=paru; AUR_OPTS=(--skipreview)
elif command -v yay &>/dev/null; then
    # yay enables the clean/diff menus by default (edit menu is off), so None
    # answers "view/edit nothing" and mirrors paru's --skipreview.
    AUR_HELPER=yay; AUR_OPTS=(--answerclean None --answerdiff None --answeredit None)
fi

# ------------------------------
# 7. Update Function
# ------------------------------
perform_update() {
    # Step 1: Pre-update snapshot for rollback
    _info "$MSG_STEP_1"
    if ! command -v snapper >/dev/null 2>&1; then
        _warn "$MSG_NO_SNAPPER"
    else
        CONFIGS=($(sudo snapper list-configs | awk 'NR>2 {print $1}'))
        if [[ ${#CONFIGS[@]} -eq 0 ]]; then
            _warn "$MSG_NO_SNAPCFG"
        else
            for conf in "${CONFIGS[@]}"; do
                sudo snapper -c "$conf" cleanup number
                sudo snapper -c "$conf" create --description "pre-archupdate-${conf}" --cleanup-algorithm number
                _success "$(printf "$MSG_SNAP_CREATED" "$conf")"
            done
        fi
    fi

    # Step 2: Sync DB & update keyrings
    _info "$MSG_STEP_2"
    KEYRING_TARGETS="archlinux-keyring"
    grep -q "^\[archlinuxcn\]" /etc/pacman.conf && KEYRING_TARGETS+=" archlinuxcn-keyring"
    if sudo pacman -Sy --needed --noconfirm ${KEYRING_TARGETS}; then
        _success "$MSG_KEYRING_OK"
    else
        _warn "$MSG_KEYRING_WARN"
    fi

    # Step 3: Upgrade official repos (failure means a partial upgrade: fatal)
    _info "$MSG_STEP_3"
    sudo pacman -Su || _error "$MSG_WARN_PARTIAL"
    _success "$MSG_REPO_OK"

    # Step 4: Upgrade AUR (failure is non-fatal: the repos are already upgraded)
    _info "$MSG_STEP_4"
    if [[ -z $AUR_HELPER ]]; then
        _warn "$MSG_AUR_NONE"
    elif "$AUR_HELPER" -Sua "${AUR_OPTS[@]}"; then
        _success "$MSG_AUR_OK"
    else
        _warn "$MSG_AUR_FAIL"
        _warn "$(printf "$MSG_AUR_RETRY" "$AUR_HELPER -Sua")"
    fi

    # Step 5: Flatpak
    _info "$MSG_STEP_5"
    if command -v flatpak >/dev/null 2>&1; then
        flatpak update -y || _warn "$MSG_FLATPAK_FAIL"
    else
        _warn "$MSG_FLATPAK_NONE"
    fi

    # Step 6: GRUB
    _info "$MSG_STEP_6"
    if ! command -v grub-mkconfig >/dev/null 2>&1; then
        _warn "$MSG_GRUB_MISSING"
    elif sudo env -u LANGUAGE LC_ALL=C.UTF-8 grub-mkconfig -o /boot/grub/grub.cfg; then
        _success "$MSG_GRUB_OK"
    else
        _warn "$MSG_GRUB_FAIL"
    fi

    # Step 7: Mise
    _info "$MSG_STEP_7"
    if command -v mise >/dev/null 2>&1; then
        mise self-update -y
        mise upgrade
        rustup update
    else
        _warn "$MSG_MISE_NONE"
    fi

    _success "$MSG_DONE"
}

# ------------------------------
# 8. Main Execution
# ------------------------------
_info "$(printf "$MSG_PREPARING" "pacman${AUR_HELPER:+ + $AUR_HELPER}")"
_info "$MSG_FETCHING"

# Python script for news parsing
PYTHON_SCRIPT=$(cat <<'EOF'
import sys
import xml.etree.ElementTree as ET
try:
    def clean(text):
        """Strip control chars (incl. C1 128-159) to prevent terminal escape injection."""
        return ''.join(c for c in (text or '') if ord(c) >= 32 and not 127 <= ord(c) <= 159)
    def item_text(item, tag):
        el = item.find(tag)
        return clean(el.text if el is not None else '')
    limit = int(sys.argv[1])
    header_template = sys.argv[2]
    sys.stdin.reconfigure(encoding='utf-8')
    raw_data = sys.stdin.read()
    if not raw_data.strip(): sys.exit(1)
    root = ET.fromstring(raw_data)
    items = root.findall('./channel/item')[:limit]
    print(f'\n\033[1;33m{header_template.format(len(items))}\033[0m\n')
    for item in items:
        title = item_text(item, 'title') or '(untitled)'
        link = item_text(item, 'link')
        pub_date = item_text(item, 'pubDate')
        date_str = pub_date[:16] or 'No date'
        check_text = title.lower()
        if any(x in check_text for x in ['intervention', 'manual', '手动', '干预']):
            color = '\033[1;31m'; prefix = '!!!'
        else:
            color = '\033[1;32m'; prefix = ''
        # OSC 8 hyperlink for terminal clickable links (only with a target)
        osc8_start = osc8_end = ''
        if link:
            osc8_start = f'\033]8;;{link}\033\\'; osc8_end = '\033]8;;\033\\'
        print(f'{color}{osc8_start}[{date_str}] {prefix}{title}{osc8_end}\033[0m')
except Exception as e:
    sys.stderr.write(f'\nParse Error: {e}\n')
    sys.exit(1)
EOF
)

# Fetch news and pipe to python for processing
NEWS_URL="https://archlinux.org/feeds/news/"
[ "$NEWS_SOURCE" == "cn" ] && NEWS_URL="https://www.archlinuxcn.org/category/news/feed/"

if curl -fsS -L --tls-max 1.2 --connect-timeout 15 --max-time 30 -A "Mozilla/5.0" "$NEWS_URL" \
    | python -c "$PYTHON_SCRIPT" "$COUNT_LIMIT" "$MSG_NEWS_HEADER"; then
    # News fetched successfully
    printf "\n"
    if ask Y "$MSG_CONFIRM"; then
        perform_update
    else
        _warn "$MSG_CANCEL"
        exit 0
    fi
else
    # Failed to fetch or parse news
    printf "\n"
    _warn "$MSG_ERR_FETCH"
    if ask N "$MSG_FORCE_ASK"; then
        _warn "$MSG_FORCING"
        perform_update
    else
        _info "$MSG_EXIT"
        exit 1
    fi
fi
